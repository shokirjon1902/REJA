<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/main.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <title>Portfolio</title>
  </head>

  <body>
    <div class="frame">
      <div class="main_frame">
        <div class="left_frame">
          <div class="left_1">
            <div class="left_1_1">
              <img
                src="images/profile.png"
                width="156px"
                height="142px"
                alt=""
              />
            </div>
            <div class="left_1_2"><%=user.name%></div>
            <div class="left_1_3"><%=user.profession%></div>
            <div class="left_icons">
              <a href="" class="link_href">
                <div class="icon">
                  <img src="icon/Icons-facebook.svg" alt="" class="icon_1" />
                </div>
              </a>
              <a href="" class="link_href">
                <div class="icon">
                  <img src="icon/Icons-instagram.svg" alt="" class="icon_1" />
                </div>
              </a>
              <a href="" class="link_href">
                <div class="icon">
                  <img src="icon/Icons-twitter.svg" alt="" class="icon_1" />
                </div>
              </a>
              <a href="" class="link_href">
                <div class="icon">
                  <img src="icon/Icons-linkedin .svg" alt="" class="icon_1" />
                </div>
              </a>
              <a href="" class="link_href">
                <div class="icon">
                  <img src="icon/Icons-Youtube .svg" alt="" class="icon_1" />
                </div>
              </a>
              <a href="" class="link_href">
                <div class="icon">
                  <img src="icon/Icons-dribbble .svg" alt="" class="icon_1" />
                </div>
              </a>
            </div>
          </div>
          <div class="marginer_1"></div>
          <div class="left_2">
            <div class="left_2_1">
              <div class="age">
                <div class="rectangle">
                  <div class="age_text">age:</div>
                </div>
                <div class="age_number"><%=user.age%></div>
              </div>
          </div>
          <div class="left_2_1">
              <div class="age">
                <div class="r_rectangle">
                  <div class="r_text">residence:</div>
                </div>
                <div class="r_number"><%=user.residence%></div>
              </div>
          </div>
          <div class="left_2_1">
              <div class="age">
                <div class="f_rectangle">
                  <div class="f_text">freelance:</div>
                </div>
                <div class="f_number">Available</div>
              </div>
          </div>
          <div class="left_2_1">
              <div class="age">
                <div class="ad_rectangle">
                  <div class="ad_text">adress:</div>
                </div>
                <div class="ad_number"><%=user.adress%></div>
              </div>
          </div>
          <div class="marginer"></div>
          <div class="left_3">
            <div class="languages">
              <h2>languages</h2>

          <div class="bangla">
            <span class="l_name">Bangla</span>
            <span class="l_percent">100%</span>
          </div>
          <div class="l_rectangle_">
            <div class="l_rectangle_2">
              <div class="percent_100"></div>
            </div>
          </div>
          <div class="bangla">
            <span class="l_name">english</span>
            <span class="l_percent">80%</span>
          </div>
          <div class="l_rectangle_">
            <div class="l_rectangle_2">
              <div class="percent_80"> </div>
            </div>
          </div>
          <div class="bangla">
            <span class="l_name">spanish</span>
            <span class="l_percent">60%</span>
          </div>
          <div class="l_rectangle_">
            <div class="l_rectangle_2">
              <div class="percent_60"></div>
            </div>
          </div>

            </div>
          



          </div>
          <div class="marginer"></div>
          <div class="left_4">
            <img src="images/Skills.svg" alt="">
          </div>
          <div class="marginer"></div>
          <div class="left_5">
            <img src="images/Extra Skills.svg" alt="">
          </div>
          <div class="marginer"></div>
        </div>
        
      
      </div>
      <div class="midd_frame">
          <div class="midd_top"></div>
          <div class="midd_bott"></div>
        </div>
        <div class="right_frame"></div>
    </div>
  </body>
</html>
  